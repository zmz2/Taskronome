<Window x:Class="Taskronome.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskronome"
        Width="1040"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource PrimaryBrush}" />
                    <Ellipse Width="28" Height="28" Stroke="White" StrokeThickness="3" />
                    <Line X1="24" Y1="24" X2="24" Y2="13" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" />
                    <Line X1="24" Y1="24" X2="33" Y2="29" Stroke="White" StrokeThickness="3" StrokeEndLineCap="Round" />
                    <Ellipse Width="5" Height="5" Fill="White" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppName}" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource Tagline}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SystemPauseText}" Foreground="{StaticResource WarningBrush}" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,12,24,0" Padding="12,8" CornerRadius="7" Background="#EEF2FF" BorderBrush="#D9E0FF" BorderThickness="1">
            <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" />
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="18,12,18,18" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource TasksTab}">
                <Grid Margin="6,14,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="{DynamicResource NewTask}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEditTasks}" Click="NewTaskButton_Click" />
                        <Button Content="{DynamicResource EditTask}" IsEnabled="{Binding CanEditSelectedTask}" Click="EditTaskButton_Click" />
                        <Button Content="{DynamicResource DeleteTask}" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanEditSelectedTask}" Click="DeleteTaskButton_Click" />
                        <Button Content="{DynamicResource MoveUp}" IsEnabled="{Binding CanEditSelectedTask}" Click="MoveUpButton_Click" />
                        <Button Content="{DynamicResource MoveDown}" IsEnabled="{Binding CanEditSelectedTask}" Click="MoveDownButton_Click" />
                        <Button Content="{DynamicResource ToggleEnabled}" IsEnabled="{Binding CanEditSelectedTask}" Click="ToggleEnabledButton_Click" />
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource CycleDuration}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding CycleDurationText}" FontWeight="Bold" Margin="8,0,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource ReopenTask}" IsEnabled="{Binding CanEditSelectedTask}" Click="ReopenTaskButton_Click" />
                            <Button Content="{DynamicResource ResetCompletion}" IsEnabled="{Binding CanEditTasks}" Click="ResetCompletionButton_Click" />
                        </WrapPanel>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding TaskRows}"
                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="TaskGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="48" />
                            <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{DynamicResource TimeSlice}" Binding="{Binding SliceText}" Width="110" />
                            <DataGridCheckBoxColumn Header="{DynamicResource Enabled}" Binding="{Binding Enabled}" Width="75" />
                            <DataGridTextColumn Header="{DynamicResource Completed}" Binding="{Binding CompletionText}" Width="105" />
                            <DataGridTextColumn Header="{DynamicResource TodayTime}" Binding="{Binding TodayText}" Width="135" />
                            <DataGridTextColumn Header="{DynamicResource Notes}" Binding="{Binding Notes}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="轮转期间任务列表会锁定；停止轮转后才能编辑、删除或重排。"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource StartRotation}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,11"
                                IsEnabled="{Binding CanStart}"
                                Click="StartRotationButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource RunningTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,6">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource CurrentTask}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="{Binding CurrentTaskName}" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="12,8" />
                                <TextBlock Grid.Row="2" Text="{Binding RemainingText}" FontFamily="Consolas" FontSize="66" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,12" />
                                <ProgressBar Grid.Row="3" Height="12" Maximum="100" Value="{Binding ProgressPercent}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="20"
                                CornerRadius="12"
                                Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                Visibility="{Binding IsAwaitingConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="轮到这项任务了" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14" />
                                <Button x:Name="ConfirmTaskButton"
                                        Content="{DynamicResource ConfirmButton}"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="17"
                                        Padding="28,13"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding CanConfirm}"
                                        Click="ConfirmTaskButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                CornerRadius="10"
                                Background="#FFF1F2"
                                BorderBrush="#FECDD3"
                                BorderThickness="1"
                                Visibility="{Binding IsAbsentPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="10 秒内未确认，已判定暂时不在电脑前。轮转已暂停，离开时间不会计入任何任务。"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DangerBrush}" />
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                CornerRadius="10"
                                Background="#FFFBEB"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                Visibility="{Binding IsSystemPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="系统锁屏、睡眠、会话断开、进程重启或异常计时空档触发了安全暂停。请确认在场后恢复。"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource NextTask}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding NextTaskName}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="当前状态" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding StateText}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Button Content="{Binding PauseResumeText}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanPauseResume}" Click="PauseResumeButton_Click" />
                            <Button Content="{DynamicResource SkipSlice}" IsEnabled="{Binding CanSkip}" Click="SkipButton_Click" />
                            <Button Content="{DynamicResource CompleteEarly}" IsEnabled="{Binding CanComplete}" Click="CompleteButton_Click" />
                            <Button Content="{DynamicResource StopRotation}" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource StatisticsTab}">
                <Grid Margin="6,14,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatisticsScope}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatisticsScopes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedStatisticsScope, Mode=TwoWay}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource TotalRecorded}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding StatisticsTotalText}" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="{DynamicResource ExportCsv}" Style="{StaticResource PrimaryButton}" Click="ExportCsvButton_Click" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding StatisticRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding TaskName}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource SegmentCount}" Binding="{Binding SegmentCount}" Width="110" />
                            <DataGridTextColumn Header="实际时长" Binding="{Binding DurationText}" Width="140" />
                            <DataGridTextColumn Header="{DynamicResource Share}" Binding="{Binding ShareText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{DynamicResource RecentEvents}" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,9" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding EventRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource OccurredAt}" Binding="{Binding OccurredAtText}" Width="125" />
                            <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding TaskName}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource EventType}" Binding="{Binding TypeText}" Width="125" />
                            <DataGridTextColumn Header="{DynamicResource Detail}" Binding="{Binding Detail}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource SettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="提醒与窗口" FontSize="19" FontWeight="Bold" Margin="0,0,0,8" />
                                <CheckBox Content="{DynamicResource AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                                <CheckBox Content="{DynamicResource PlaySound}" IsChecked="{Binding PlaySound, Mode=TwoWay}" />
                                <CheckBox Content="{DynamicResource ShowNotification}" IsChecked="{Binding ShowNotification, Mode=TwoWay}" />
                                <CheckBox Content="{DynamicResource MinimizeToTray}" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                                <Button Content="{DynamicResource TestNotification}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="TestNotificationButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DataLocation}" FontSize="19" FontWeight="Bold" />
                                <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" Margin="0,10,0,10" />
                                <Button Content="{DynamicResource OpenDataFolder}" HorizontalAlignment="Left" Click="OpenDataFolderButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PrivacyTitle}" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource PrivacyText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{DynamicResource KeyboardTitle}" FontSize="19" FontWeight="Bold" Margin="0,18,0,0" />
                                <TextBlock Text="{DynamicResource KeyboardText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="Taskronome · Give every task its turn." Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
