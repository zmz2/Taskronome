<Window x:Class="Taskronome.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskronome.App"
        AutomationProperties.AutomationId="MainWindow"
        Title="Taskronome"
        Width="1040"
        Height="720"
        MinWidth="400"
        MinHeight="300"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource PrimaryBrush}" />
                    <Ellipse Width="28" Height="28" Stroke="White" StrokeThickness="3" />
                    <Line X1="24" Y1="24" X2="24" Y2="13" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" />
                    <Line X1="24" Y1="24" X2="33" Y2="29" Stroke="White" StrokeThickness="3" StrokeEndLineCap="Round" />
                    <Ellipse Width="5" Height="5" Fill="White" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource AppName}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Tagline}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" MaxWidth="120" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                    <TextBlock Text="{Binding SystemPauseText}" Foreground="{StaticResource WarningBrush}" FontSize="12" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <local:ResponsiveContentHost Grid.Row="1" Margin="12,8,12,0" FallbackMeasureWidth="320">
            <Border Padding="10,6" CornerRadius="7" Background="#EEF2FF" BorderBrush="#D9E0FF" BorderThickness="1">
                <TextBlock Text="{Binding FeedbackMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource InkBrush}"
                           AutomationProperties.AutomationId="FeedbackMessage" />
            </Border>
        </local:ResponsiveContentHost>

        <TabControl x:Name="MainTabs"
                    Grid.Row="2"
                    Margin="10,8,10,10"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="MainTabs">
            <TabItem Header="{DynamicResource TasksTab}" AutomationProperties.AutomationId="TasksTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              AutomationProperties.AutomationId="TasksContent">
                    <local:ResponsiveContentHost FallbackMeasureWidth="320">
                        <Grid Margin="6,10,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="{DynamicResource NewTask}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEditTasks}" Click="NewTaskButton_Click" AutomationProperties.AutomationId="NewTaskButton" />
                        <Button Content="{DynamicResource EditTask}" IsEnabled="{Binding CanEditSelectedTask}" Click="EditTaskButton_Click" AutomationProperties.AutomationId="EditTaskButton" />
                        <Button Content="{DynamicResource DeleteTask}" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanEditSelectedTask}" Click="DeleteTaskButton_Click" AutomationProperties.AutomationId="DeleteTaskButton" />
                        <Button Content="{DynamicResource MoveUp}" IsEnabled="{Binding CanEditSelectedTask}" Click="MoveUpButton_Click" AutomationProperties.AutomationId="MoveUpButton" />
                        <Button Content="{DynamicResource MoveDown}" IsEnabled="{Binding CanEditSelectedTask}" Click="MoveDownButton_Click" AutomationProperties.AutomationId="MoveDownButton" />
                        <Button Content="{DynamicResource ToggleEnabled}" IsEnabled="{Binding CanEditSelectedTask}" Click="ToggleEnabledButton_Click" AutomationProperties.AutomationId="ToggleEnabledButton" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="{DynamicResource CycleDuration}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding CycleDurationText}" FontWeight="Bold" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Content="{DynamicResource ReopenTask}" IsEnabled="{Binding CanEditSelectedTask}" Click="ReopenTaskButton_Click" AutomationProperties.AutomationId="ReopenTaskButton" />
                        <Button Content="{DynamicResource ResetCompletion}" IsEnabled="{Binding CanEditTasks}" Click="ResetCompletionButton_Click" AutomationProperties.AutomationId="ResetCompletionButton" />
                    </WrapPanel>

                    <DataGrid Grid.Row="2"
                              MinHeight="120"
                              ItemsSource="{Binding TaskRows}"
                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="TaskGrid_MouseDoubleClick"
                              AutomationProperties.AutomationId="TaskGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="0.45*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding Name}" Width="1.6*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            <DataGridTextColumn Header="{DynamicResource TimeSlice}" Binding="{Binding SliceText}" Width="1.2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            <DataGridCheckBoxColumn Header="{DynamicResource Enabled}" Binding="{Binding Enabled}" Width="0.9*" MinWidth="0" />
                            <DataGridTextColumn Header="{DynamicResource Completed}" Binding="{Binding CompletionText}" Width="1.2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            <DataGridTextColumn Header="{DynamicResource TodayTime}" Binding="{Binding TodayText}" Width="1.4*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            <DataGridTextColumn Header="{DynamicResource Notes}" Binding="{Binding Notes}" Width="1.8*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="轮转期间任务列表会锁定；停止轮转后才能编辑、删除或重排。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource StartRotation}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,11"
                                IsEnabled="{Binding CanStart}"
                                Click="StartRotationButton_Click"
                                AutomationProperties.AutomationId="StartRotationButton" />
                    </Grid>
                        </Grid>
                    </local:ResponsiveContentHost>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource RunningTab}" AutomationProperties.AutomationId="RunningTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              AutomationProperties.AutomationId="RunningContent">
                    <local:ResponsiveContentHost FallbackMeasureWidth="320">
                        <StackPanel Margin="6,10,6,6">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource CurrentTask}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="{Binding CurrentTaskName}" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="12,8" AutomationProperties.AutomationId="CurrentTaskText" />
                                <TextBlock Grid.Row="2" Text="{Binding RemainingText}" FontFamily="Consolas" FontSize="66" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,12" AutomationProperties.AutomationId="RemainingText" />
                                <ProgressBar Grid.Row="3" Height="12" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="20"
                                CornerRadius="12"
                                Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                Visibility="{Binding IsAwaitingConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="轮到这项任务了" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" AutomationProperties.AutomationId="ConfirmationPanel" />
                                <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14" AutomationProperties.AutomationId="ConfirmationText" />
                                <Button x:Name="ConfirmTaskButton"
                                        Content="{DynamicResource ConfirmButton}"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="17"
                                        Padding="28,13"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding CanConfirm}"
                                        Click="ConfirmTaskButton_Click"
                                        AutomationProperties.AutomationId="ConfirmTaskButton" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                CornerRadius="10"
                                Background="#FFF1F2"
                                BorderBrush="#FECDD3"
                                BorderThickness="1"
                                Visibility="{Binding IsAbsentPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="10 秒内未确认，已判定暂时不在电脑前。轮转已暂停，离开时间不会计入任何任务。"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DangerBrush}" AutomationProperties.AutomationId="AbsentPausePanel" />
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                CornerRadius="10"
                                Background="#FFFBEB"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                Visibility="{Binding IsSystemPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="系统锁屏、睡眠、会话断开、进程重启或异常计时空档触发了安全暂停。请确认在场后恢复。"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource WarningBrush}" AutomationProperties.AutomationId="SystemPausePanel" />
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource NextTask}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding NextTaskName}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="当前状态" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding StateText}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Button Content="{Binding PauseResumeText}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanPauseResume}" Click="PauseResumeButton_Click" AutomationProperties.AutomationId="PauseResumeButton" />
                            <Button Content="{DynamicResource SkipSlice}" IsEnabled="{Binding CanSkip}" Click="SkipButton_Click" AutomationProperties.AutomationId="SkipButton" />
                            <Button Content="{DynamicResource CompleteEarly}" IsEnabled="{Binding CanComplete}" Click="CompleteButton_Click" AutomationProperties.AutomationId="CompleteButton" />
                            <Button Content="{DynamicResource StopRotation}" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" AutomationProperties.AutomationId="StopButton" />
                        </WrapPanel>
                        </StackPanel>
                    </local:ResponsiveContentHost>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource StatisticsTab}" AutomationProperties.AutomationId="StatisticsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              AutomationProperties.AutomationId="StatisticsContent">
                    <local:ResponsiveContentHost FallbackMeasureWidth="320">
                        <StackPanel Margin="6,10,6,6">
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource StatisticsScope}" VerticalAlignment="Center" Margin="0,0,10,8" AutomationProperties.AutomationId="StatisticsScopeLabel" />
                            <ComboBox Width="220"
                                      Margin="0,0,12,8"
                                      ItemsSource="{Binding StatisticsScopes}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedStatisticsScope, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="StatisticsScopeComboBox" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                                <TextBlock Text="{DynamicResource TotalRecorded}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding StatisticsTotalText}" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" />
                            </StackPanel>
                            <Button Content="{DynamicResource ExportCsv}" Style="{StaticResource PrimaryButton}" Click="ExportCsvButton_Click" AutomationProperties.AutomationId="ExportCsvButton" />
                        </WrapPanel>

                        <DataGrid MinHeight="120" ItemsSource="{Binding StatisticRows}" AutomationProperties.AutomationId="StatisticsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding TaskName}" Width="2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="{DynamicResource SegmentCount}" Binding="{Binding SegmentCount}" Width="1*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="实际时长" Binding="{Binding DurationText}" Width="1.2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="{DynamicResource Share}" Binding="{Binding ShareText}" Width="1*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{DynamicResource RecentEvents}" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,9" />
                        <DataGrid MinHeight="160" ItemsSource="{Binding EventRows}" AutomationProperties.AutomationId="EventsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource OccurredAt}" Binding="{Binding OccurredAtText}" Width="1.4*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="{DynamicResource TaskName}" Binding="{Binding TaskName}" Width="2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="{DynamicResource EventType}" Binding="{Binding TypeText}" Width="1.2*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                                <DataGridTextColumn Header="{DynamicResource Detail}" Binding="{Binding Detail}" Width="2.5*" MinWidth="0" ElementStyle="{StaticResource WrappedDataGridText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </StackPanel>
                    </local:ResponsiveContentHost>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource SettingsTab}" AutomationProperties.AutomationId="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              AutomationProperties.AutomationId="SettingsContent">
                    <local:ResponsiveContentHost FallbackMeasureWidth="320">
                        <StackPanel Margin="6,14,6,6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="提醒与窗口" FontSize="19" FontWeight="Bold" Margin="0,0,0,8" />
                                <CheckBox Content="{DynamicResource AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" AutomationProperties.AutomationId="AlwaysOnTopCheckBox" />
                                <CheckBox Content="{DynamicResource PlaySound}" IsChecked="{Binding PlaySound, Mode=TwoWay}" AutomationProperties.AutomationId="PlaySoundCheckBox" />
                                <CheckBox Content="{DynamicResource ShowNotification}" IsChecked="{Binding ShowNotification, Mode=TwoWay}" AutomationProperties.AutomationId="ShowNotificationCheckBox" />
                                <CheckBox Content="{DynamicResource MinimizeToTray}" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" AutomationProperties.AutomationId="MinimizeToTrayCheckBox" />
                                <Button Content="{DynamicResource TestNotification}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="TestNotificationButton_Click" AutomationProperties.AutomationId="TestNotificationButton" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DataLocation}" FontSize="19" FontWeight="Bold" />
                                <TextBox Text="{Binding DataDirectory, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="36"
                                         Margin="0,10,0,10"
                                         AutomationProperties.AutomationId="DataDirectoryTextBox" />
                                <Button Content="{DynamicResource OpenDataFolder}" HorizontalAlignment="Left" Click="OpenDataFolderButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PrivacyTitle}" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource PrivacyText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="PrivacyTextBlock" />
                                <TextBlock Text="{DynamicResource KeyboardTitle}" FontSize="19" FontWeight="Bold" Margin="0,18,0,0" />
                                <TextBlock Text="{DynamicResource KeyboardText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="KeyboardTextBlock" />
                                <TextBlock Text="Taskronome · Give every task its turn." Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </local:ResponsiveContentHost>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
